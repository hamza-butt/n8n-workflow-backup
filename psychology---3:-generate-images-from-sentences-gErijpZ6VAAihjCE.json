ppingMode":"defineBelow","value":{"prompt":"={{ $json.image_prompt }}"},"matchingColumns":["prompt"],"schema":[{"id":"prompt","displayName":"prompt","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string","removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[3680,1168],"id":"8726c407-a724-4a72-b9fe-6daf455012b8","name":"Call 'Image Generate'1"},{"parameters":{"amount":10},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[3888,1168],"id":"1586d923-222a-4c65-bb4a-16decfc790f9","name":"Wait","webhookId":"7dc3bb5c-8d12-489e-b9c9-e2e9e71f9686"},{"parameters":{"workflowInputs":{"values":[{"name":"id","type":"number"},{"name":"subFolderId"}]}},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[1520,1152],"id":"7f5ec677-4e7d-4531-a97f-053ae82ca102","name":"Start"},{"parameters":{"modelId":{"__rl":true,"value":"gpt-5-mini","mode":"list","cachedResultName":"GPT-5-MINI"},"messages":{"values":[{"content":"={{ $('Extract Prompt').item.json.prompt_text }}","role":"system"},{"content":"=script_data: {{ JSON.stringify($json.sentences) }}\nnumberOfSentences : {{ $('Extract Hook And Sentence').item.json.count }}"}]},"jsonOutput":true,"options":{}},"type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":1.8,"position":[2688,1152],"id":"fb8e1a64-e873-4d20-8a99-6a2d5e2cac98","name":"write image prompt","credentials":{"openAiApi":{"id":"REPFRzVfqjEAVVqB","name":"OpenAi account"}}},{"parameters":{"content":"## Get Prompt and topic and make english sentences array\n","height":528,"width":896},"type":"n8n-nodes-base.stickyNote","position":[1680,880],"typeVersion":1,"id":"47c44712-da06-42c2-a3ed-66943ad0c9da","name":"Sticky Note1"},{"parameters":{"jsCode":"const gptContent = $input.first().json.content;\n\nconst hookContent = gptContent?.hook || \"\";\nconst scriptContent = gptContent?.script || [];\n\n// Combine both arrays into a single 'sentences' array\nconst sentences = [hookContent, ...scriptContent];\n\n// Get the count of the combined array\nconst count = sentences.length;\n\n// Return the language, the combined array, and its count\nreturn {\n    sentences: sentences,\n    count: count,\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2432,1152],"id":"de454cbd-cf43-4674-bb31-c6b20a953d8d","name":"Extract Hook And Sentence"},{"parameters":{"jsCode":"// Get the sentences array from the previous node's output\nconst sentences = $input.first().json.sentences;\n\n// Define the separator (space + \\u001F character)\nconst separator = \" \\u001F\";\n\n// Join all sentences in the array with the separator\nconst script = sentences.join(separator);\n\n// Return the final combined script\nreturn {\n  script: script\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2672,1552],"id":"2465e666-8979-4cd5-8ee9-2050853b38dd","name":"Make Script"},{"parameters":{"description":"This thinking tool must plan → verify → write → self-check before output.\n\n1) Parse and Count\nSplit sentences by \\u001F and confirm that scenes.length equals numberOfSentences.\nKeep each original sentence verbatim as voiceOverText.\n\n2) Plan Unified Visual Style\nUse historical realism with a subtle fantasy aura: ethereal volumetric light, faint embers, light haze, slightly heightened colors.\nEnsure one clear main subject, an uncluttered background, a strong silhouette, and a 9:16 vertical frame with a Rembrandt or chiaroscuro mood.\nPalette should be deep blue or teal shadows with warm amber or orange highlights.\nUse a 35mm lens for establishing or action and a 50mm lens for portraits or close shots, with slight background blur and soft film grain.\n\n3) Write Each Scene Prompt Using the Pattern\nInclude subject and action; era, location, and architecture; accurate clothing and props; composition choice (close, medium, or wide with framing and leading lines); lens; lighting; atmosphere; palette; and quality flags.\nExplicitly include the phrase NO TEXT VISIBLE inside every prompt.\nAppend the NEGATIVE block at the end of every prompt.\n\n4) Enforce Historical Accuracy\nPrefer verified or public-domain cues.\nIf uncertain, choose era-appropriate generic imagery instead of introducing anachronisms.\n\n5) Choose Thumbnail\nPick the most emotional or symbolic scene, preferably featuring a face or hands, and add stronger rim light, high contrast, and a mystery prop.\nInclude NO TEXT VISIBLE and the NEGATIVE block.\n\n6) Validate JSON and Rules\nEnsure scene count matches numberOfSentences.\nConfirm every prompt contains the required style elements, the NO TEXT VISIBLE callout, and the NEGATIVE block.\nReturn only the specified JSON shape."},"type":"@n8n/n8n-nodes-langchain.toolThink","typeVersion":1.1,"position":[2848,1376],"id":"af377f75-4fa5-44a6-84b3-b4752c9d3e5d","name":"Think"},{"parameters":{"resource":"file","operation":"get","owner":{"__rl":true,"value":"hamza-butt","mode":"list","cachedResultName":"hamza-butt","cachedResultUrl":"https://github.com/hamza-butt"},"repository":{"__rl":true,"value":"Business-Psychology-prompt","mode":"list","cachedResultName":"Business-Psychology-prompt","cachedResultUrl":"https://github.com/hamza-butt/Business-Psychology-prompt"},"filePath":"scenes_generation.json","additionalParameters":{}},"type":"n8n-nodes-base.github","typeVersion":1.1,"position":[1712,1152],"id":"4fdf5a37-910d-4e0c-947c-bf25e0feaf00","name":"Get Prompt File","webhookId":"be71a8d0-feeb-4ee5-948d-21986b255708","credentials":{"githubApi":{"id":"aJdyHIuO2rgJNBmt","name":"GitHub account"}}},{"parameters":{"jsCode":"// This converts the binary file 'data' into a raw text string\nconst binaryData = items[0].binary.data;\nconst fileContent = Buffer.from(binaryData.data, 'base64').toString('utf-8');\n\nreturn {\n  json: {\n    prompt_text: fileContent\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1888,1152],"id":"1910edb