e":"const gtpResponse = $input.first().json.gptResponse;\nconst gtpResponseJSON = JSON.parse(gtpResponse);\nreturn {\n  \"content\":gtpResponseJSON\n};\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-560,288],"id":"eb3bae44-6319-4007-829d-91b82682e3ac","name":"Extract GPT Response"},{"parameters":{"documentId":{"__rl":true,"value":"1mqCt-tHeu1u7fQcXObCvifCRAAzrBlOMDFT7NUypBzI","mode":"list","cachedResultName":"History","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1mqCt-tHeu1u7fQcXObCvifCRAAzrBlOMDFT7NUypBzI/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Main","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1mqCt-tHeu1u7fQcXObCvifCRAAzrBlOMDFT7NUypBzI/edit#gid=0"},"filtersUI":{"values":[{"lookupColumn":"id","lookupValue":"={{ $('Start').item.json.id }}"}]},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-752,288],"id":"9d66541c-5389-4f4f-a831-3bb213dd9ef4","name":"Get Item","credentials":{"googleSheetsOAuth2Api":{"id":"gz6mfhgkzXv8zKAX","name":"Google Sheets account"}}},{"parameters":{"jsCode":"const gptContent = $input.first().json.content;\n\nconst hookContent = gptContent?.hook || \"\";\nconst scriptContent = gptContent?.script || [];\n\n// Combine both arrays into a single 'sentences' array\nconst sentences = [hookContent, ...scriptContent];\n\n// Get the count of the combined array\nconst count = sentences.length;\n\n// Return the language, the combined array, and its count\nreturn {\n    sentences: sentences,\n    count: count,\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-384,288],"id":"64ddabc3-21da-4c86-b0dd-925a199a341d","name":"Extract Hook And Sentence"},{"parameters":{"jsCode":"// Get the sentences array from the previous node's output\nconst sentences = $input.first().json.sentences;\n\n// Define the separator (space + \\u001F character)\nconst separator = \" \\u001F\";\n\n// Join all sentences in the array with the separator\nconst script = sentences.join(separator);\n\n// Return the final combined script\nreturn {\n  script: script\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-176,288],"id":"92c80d9c-27e5-4e44-9a55-a2e8d7044679","name":"Make Script"},{"parameters":{"description":"This thinking tool must plan → verify → write → self-check before output.\n\n1) Parse and Count\nSplit sentences by \\u001F and confirm that scenes.length equals numberOfSentences.\nKeep each original sentence verbatim as voiceOverText.\n\n2) Plan Unified Visual Style\nUse historical realism with a subtle fantasy aura: ethereal volumetric light, faint embers, light haze, slightly heightened colors.\nEnsure one clear main subject, an uncluttered background, a strong silhouette, and a 9:16 vertical frame with a Rembrandt or chiaroscuro mood.\nPalette should be deep blue or teal shadows with warm amber or orange highlights.\nUse a 35mm lens for establishing or action and a 50mm lens for portraits or close shots, with slight background blur and soft film grain.\n\n3) Write Each Scene Prompt Using the Pattern\nInclude subject and action; era, location, and architecture; accurate clothing and props; composition choice (close, medium, or wide with framing and leading lines); lens; lighting; atmosphere; palette; and quality flags.\nExplicitly include the phrase NO TEXT VISIBLE inside every prompt.\nAppend the NEGATIVE block at the end of every prompt.\n\n4) Enforce Historical Accuracy\nPrefer verified or public-domain cues.\nIf uncertain, choose era-appropriate generic imagery instead of introducing anachronisms.\n\n5) Choose Thumbnail\nPick the most emotional or symbolic scene, preferably featuring a face or hands, and add stronger rim light, high contrast, and a mystery prop.\nInclude NO TEXT VISIBLE and the NEGATIVE block.\n\n6) Validate JSON and Rules\nEnsure scene count matches numberOfSentences.\nConfirm every prompt contains the required style elements, the NO TEXT VISIBLE callout, and the NEGATIVE block.\nReturn only the specified JSON shape."},"type":"@n8n/n8n-nodes-langchain.toolThink","typeVersion":1.1,"position":[192,512],"id":"9e62a522-7eff-44f0-bd4c-ab372446f606","name":"Think"},{"parameters":{"resource":"file","operation":"get","owner":{"__rl":true,"value":"hamza-butt","mode":"list","cachedResultName":"hamza-butt","cachedResultUrl":"https://github.com/hamza-butt"},"repository":{"__rl":true,"value":"Histogram-Prompt","mode":"list","cachedResultName":"Histogram-Prompt","cachedResultUrl":"https://github.com/hamza-butt/Histogram-Prompt"},"filePath":"Scenes generation prompt.json","additionalParameters":{}},"type":"n8n-nodes-base.github","typeVersion":1.1,"position":[-1104,288],"id":"10fc669a-e201-4bc5-b976-3b7c0677574f","name":"Get Prompt File","webhookId":"be71a8d0-feeb-4ee5-948d-21986b255708","credentials":{"githubApi":{"id":"aJdyHIuO2rgJNBmt","name":"GitHub account"}}},{"parameters":{"jsCode":"// This converts the binary file 'data' into a raw text string\nconst binaryData = items[0].binary.data;\nconst fileContent = Buffer.from(binaryData.data, 'base64').toString('utf-8');\n\nreturn {\n  json: {\n    prompt_text: fileContent\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-928,288],"id":"b4eeab85-4402-4d62-9c23-9c64e9e43e5c","name":"Extract Prompt"},{"parameters":{"workflowId":{"__rl":true,"value":"GZSsGZ82FdB2UdqH","mode":"list","cachedResultUrl":"/workflow/GZSsGZ82FdB2UdqH","cachedResultName":"Image Generate"},"workflowInputs":{"mappingMode":"defineBelow","value":{"prompt":"={{ $json.image_prompt }}"},"matchingColumns":["prompt"],"schema":[{"id":"prompt","displayName":"prompt","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string","removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[1632,304],"id":"c9f23e10-7b6f-43a5-b14c-bccfa9b262e1","name":"Call 'Image Generate'1"},{"par