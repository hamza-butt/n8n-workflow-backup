23396740,"mode":"list","cachedResultName":"Script","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1mqCt-tHeu1u7fQcXObCvifCRAAzrBlOMDFT7NUypBzI/edit#gid=523396740"},"filtersUI":{"values":[{"lookupColumn":"id","lookupValue":"={{ $('Start').item.json.id }}"}]},"options":{"returnFirstMatch":true}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[448,288],"id":"276d52fe-1cbe-4136-9172-341f4f38db63","name":"Extract topic","credentials":{"googleSheetsOAuth2Api":{"id":"qUK79uCQNhk2Ezmk","name":"Google Sheets account"}}},{"parameters":{"content":"## Generate images scenes and thumbnail prompt and save thumbnail to google drive","height":528,"width":864,"color":4},"type":"n8n-nodes-base.stickyNote","position":[816,0],"typeVersion":1,"id":"d0781690-26c5-4f97-9ad8-33ab70f96aaa","name":"Sticky Note2"},{"parameters":{"content":"## Generate images for all scenes and upload to google drive","height":528,"width":1280,"color":5},"type":"n8n-nodes-base.stickyNote","position":[1744,0],"typeVersion":1,"id":"e752c072-0096-4cab-b17a-3e51e4413392","name":"Sticky Note3"},{"parameters":{"jsCode":" // 1. Get input item\n  const item = $input.first().json;\n\n  // 2. Parse the fullScriptWithoutSeperator string\n  const parsedScript = JSON.parse(item.fullScript || '{}');\n\n  // 3. Extract English script\n  const script = parsedScript.en || '';\n\n  // 4. Split by '\\u001f' if present\n  const sentences = script.includes('\\u001f')\n    ? script.split('\\u001f').filter(s => s.trim() !== '')\n    : [script.trim()].filter(Boolean);\n\n  // 5. Count sentences\n  const sentenceCount = sentences.length;\n\n  // 6. Return everything\n  return {\n    \"en_text\": script,\n    sentences,\n    sentenceCount\n  };"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[624,288],"id":"966dcf31-7021-4e2b-9135-5c3c13b59d65","name":"Count Sentences"},{"parameters":{"description":"This thinking tool must plan → verify → write → self-check before output.\n\n1) Parse and Count\nSplit sentences by \\u001F and confirm that scenes.length equals numberOfSentences.\nKeep each original sentence verbatim as voiceOverText.\n\n2) Plan Unified Visual Style\nUse historical realism with a subtle fantasy aura: ethereal volumetric light, faint embers, light haze, slightly heightened colors.\nEnsure one clear main subject, an uncluttered background, a strong silhouette, and a 9:16 vertical frame with a Rembrandt or chiaroscuro mood.\nPalette should be deep blue or teal shadows with warm amber or orange highlights.\nUse a 35mm lens for establishing or action and a 50mm lens for portraits or close shots, with slight background blur and soft film grain.\n\n3) Write Each Scene Prompt Using the Pattern\nInclude subject and action; era, location, and architecture; accurate clothing and props; composition choice (close, medium, or wide with framing and leading lines); lens; lighting; atmosphere; palette; and quality flags.\nExplicitly include the phrase NO TEXT VISIBLE inside every prompt.\nAppend the NEGATIVE block at the end of every prompt.\n\n4) Enforce Historical Accuracy\nPrefer verified or public-domain cues.\nIf uncertain, choose era-appropriate generic imagery instead of introducing anachronisms.\n\n5) Choose Thumbnail\nPick the most emotional or symbolic scene, preferably featuring a face or hands, and add stronger rim light, high contrast, and a mystery prop.\nInclude NO TEXT VISIBLE and the NEGATIVE block.\n\n6) Validate JSON and Rules\nEnsure scene count matches numberOfSentences.\nConfirm every prompt contains the required style elements, the NO TEXT VISIBLE callout, and the NEGATIVE block.\nReturn only the specified JSON shape."},"type":"@n8n/n8n-nodes-langchain.toolThink","typeVersion":1.1,"position":[960,496],"id":"4959bf71-7701-4b8c-ba8a-069849622753","name":"Think"}],"connections":{"write image prompt":{"main":[[{"node":"Generate thumbnail","type":"main","index":0}]]},"Start":{"main":[[{"node":"Get Image Generation Prompt","type":"main","index