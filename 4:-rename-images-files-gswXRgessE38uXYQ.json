{"updatedAt":"2026-02-18T13:51:51.000Z","createdAt":"2026-02-04T23:03:34.416Z","id":"gswXRgessE38uXYQ","name":"4: Rename Images Files","active":false,"isArchived":false,"nodes":[{"parameters":{"operation":"update","fileId":{"__rl":true,"value":"={{ $json.id }}","mode":"id"},"newUpdatedFileName":"={{ $json.newName }}","options":{}},"id":"1fb22bcc-ffde-49e8-acbe-121e54640996","name":"Rename File","type":"n8n-nodes-base.googleDrive","position":[944,16],"typeVersion":3,"credentials":{"googleDriveOAuth2Api":{"id":"TPv6wCUbK61xtBX9","name":"Google Drive account"}}},{"parameters":{"workflowInputs":{"values":[{"name":"id","type":"any"},{"name":"subFolderId"}]}},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-112,0],"id":"afdcfc95-334a-4b21-8553-082cdaa05bf5","name":"Start"},{"parameters":{"resource":"fileFolder","searchMethod":"query","queryString":"=  '{{ $json.subFolderId }}' in parents and trashed = false ","returnAll":true,"filter":{},"options":{}},"id":"6765091c-6bf4-44e7-a07c-bdfc1ee3b672","name":"Get Files","type":"n8n-nodes-base.googleDrive","position":[96,0],"typeVersion":3,"credentials":{"googleDriveOAuth2Api":{"id":"TPv6wCUbK61xtBX9","name":"Google Drive account"}}},{"parameters":{"jsCode":"// Filter for PNG files\nconst filteredFiles = $input.all().filter(item => {\n  const fileName = item.json.name.toLowerCase();\n  return fileName.endsWith('.png');\n});\n\n// Map the data and extract the leading number for the new name\nconst fileArray = filteredFiles.map(item => {\n  const oldName = item.json.name;\n  \n  // This regex finds the digits at the start of the name (e.g., \"12\" from \"12_Dark_noir...\")\n  const match = oldName.match(/^\\d+/); \n  const fileNumber = match ? match[0] : \"unknown\";\n\n  return {\n    id: item.json.id,\n    oldName: oldName,\n    newName: `${fileNumber}.png`\n  };\n});\n\n// Return as a single item containing the array\nreturn [\n  {\n    json: {\n      files: fileArray\n    }\n  }\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[304,0],"id":"482c37fe-1e36-4474-a791-dbf8d9260bab","name":"Code in JavaScript"},{"parameters":{"fieldToSplitOut":"files","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[512,0],"id":"249844ac-7a12-48cc-94c2-7343489c6d08","name":"Split Out"},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[720,0],"id":"8af3fab6-96c9-491d-9dd3-f0f404e7921a","name":"Loop Over Items"},{"parameters":{"mode":"raw","jsonOutput":"={\n  \"File_Renamed\" : true\n}\n","options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[944,-160],"id":"dd4cf9ed-04d6-494f-8b3a-495a009d5ed4","name":"Return"}],"connections":{"Start":{"main":[[{"node":"Get Files","type":"main","index":0}]]},"Get Files":{"main":[[{"node":"Code in JavaScript","type":"main","index":0}]]},"Code in JavaScript":{"main":[[{"node":"Split Out","type":"main","index":0}]]},"Split Out":{"main":[[{"node":"Loop Over Items","type":"main","index":0}]]},"Loop Over Items":{"main":[[{"node":"Return","type":"main","index":0}],[{"node":"Rename File","type":"main","index":0}]]},"Rename File":{"main":[[{"node":"Loop Over Items","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{"Start":[{"json":{"id":1,"subFolderId":"1OtYgu-lqgVzWF2xbJDIWXIF2VCBfXihE"}}]},"versionId":"82242267-ecdd-4b03-9ae9-5ca6a2627c39","triggerCount":0,"shared":[{"updatedAt":"2026-02-04T23:03:34.458Z","createdAt":"2026-02-04T23:03:34.458Z","role":"workflow:owner","workflowId":"gswXRgessE38uXYQ","projectId":"8BeUYvfQS9ChxO6n"}],"tags":[]}