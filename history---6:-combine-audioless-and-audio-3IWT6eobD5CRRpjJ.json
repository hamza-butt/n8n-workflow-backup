eplace(/\\s{2,}/g, ' ')\n  .trim();\n\n// Keep original fields and add hookText\nreturn [\n  {\n    json: {\n      hookText,\n    },\n  },\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-576,80],"id":"a06426f2-242e-4a1b-b318-c66aad7f3086","name":"Convert Hook Sentence To Hook"},{"parameters":{"jsCode":"const data = $input.first().json;\nconst segments = Array.isArray(data.segments) ? data.segments : [];\nif (!segments.length) throw new Error('No segments found.');\n\n// Strict: use segment-level times, no padding\nconst start = Math.max(0, Number(segments[0].start));\nconst end   = Number(segments[segments.length - 1].end);\n\nreturn [{\n  json: {\n    hook_start_time: +start.toFixed(3),\n    hook_end_time:   +end.toFixed(3),\n    hook_duration:   +(end - start).toFixed(3),\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[192,80],"id":"d6f6ae5b-96df-4e99-aa2c-da8c318f8e26","name":"set Hook Timing"},{"parameters":{"method":"POST","url":"http://host.docker.internal:8000/get_word_timing","sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"parameterType":"formBinaryData","name":"file","inputDataFieldName":"data"},{"name":"script","value":"={{ $('Make Script').item.json.script }}"},{"name":"language","value":"={{ $('Start').item.json.language }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[80,304],"id":"c53cb43d-9bea-4ada-9a91-b384b5dd8bd3","name":"Get Word Timing"},{"parameters":{},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[384,96],"id":"fcd4589d-2f9f-418a-953f-b0959639b245","name":"Merge"},{"parameters":{"method":"POST","url":"http://host.docker.internal:8000/get_word_timing","sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"parameterType":"formBinaryData","name":"file","inputDataFieldName":"data"},{"name":"script","value":"={{ $('Convert Hook Sentence To Hook').item.json.hookText }}"},{"name":"language","