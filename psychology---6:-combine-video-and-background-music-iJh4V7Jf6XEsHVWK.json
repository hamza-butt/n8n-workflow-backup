ideoSegments = items.map(item => item.json);\n\nif (!videoSegments || videoSegments.length === 0) {\n  // If no data, return an error item\n  return [{ json: { error: \"No video segments found.\" } }];\n}\n\n// 2. Loop through every segment and sum the 'audioDuration'\nfor (let i = 0; i < videoSegments.length; i++) {\n  const currentSegment = videoSegments[i];\n  const duration = currentSegment.audioDuration;\n\n  // 3. Ensure the duration field exists and is a valid number\n  if (duration !== undefined && duration !== null) {\n    // We use parseFloat to handle potential string/number mix\n    const segmentDuration = parseFloat(duration);\n\n    if (!isNaN(segmentDuration)) {\n      hookEndTime += segmentDuration; // Cumulative sum of all durations\n    } else {\n      console.warn(`'audioDuration' for segment ${i + 1} is not a valid number (${duration}). Skipping contribution.`);\n    }\n  } else {\n    console.warn(`'audioDuration' is missing for segment ${i + 1}. Skipping contribution.`);\n  }\n}\n\n// 4. Format the final output object\nconst outputData = {\n  hookStartTime,\n  // Rounding to 3 decimal places for clean output\n  hookEndTime: parseFloat(hookEndTime.toFixed(3))\n};\n\n// 5. Return the new object as a single n8n item.\nreturn [{\n  json: outputData\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[400,32],"id":"1e90a7e1-a760-48b2-804c-4afbbe7170bb","name":"Extract Hook Time"},{"parameters":{"operation":"download","fileId":{"__rl":true,"value":"={{ $('Start').item.json.musicUrl }}","mode":"url"},"options":{}},"type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[624,32],"id":"005d6460-aca5-4b79-9816-4c9ccde682b2","name":"Download Background Music","credentials":{"googleDriveOAuth2Api":{"id":"TPv6wCUbK61xtBX9","name":"Google Drive account"}}},{"parameters":{"operation":"download","fileId":{"__rl":true,"value":"={{ $('Start').first().json.logoUrl }}","mode":"url"},"options":{}},"type":"n8n-nodes-base.googleDrive","typeVersion":