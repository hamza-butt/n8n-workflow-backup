{$json.id}}\",\n  \"sub_folder_name\" : \"{{$json.name}}\"\n}\n","options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[2800,288],"id":"42d10a58-ad6a-49d8-88fa-b9f4388bb5d8","name":"Return"},{"parameters":{"workflowInputs":{"values":[{"name":"row_number","type":"any"},{"name":"channel_name"}]}},"id":"2247bebd-8216-4b3b-b433-ac3170c9dc5e","typeVersion":1.1,"name":"Start","type":"n8n-nodes-base.executeWorkflowTrigger","position":[672,256]},{"parameters":{},"type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1776,272],"id":"b31d215f-b199-4361-b8c7-e2afbb15a061","name":"No Operation, do nothing"},{"parameters":{},"type":"n8n-nodes-base.noOp","typeVersion":1,"position":[2576,288],"id":"5e0d1306-271d-4b6a-ae9c-8e12445d9f5c","name":"No Operation, do nothing1"},{"parameters":{"mode":"raw","jsonOutput":"{\n  \"row_number_temp\": 2,\n  \"channel_name_temp\" : \"Dark Psyche\"\n}\n","options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[896,256],"id":"5e6a5bf7-77f4-46f1-a9ab-a2001ef6a0f7","name":"Default value"},{"parameters":{"content":"## Reels and subfolder creation\n\n1️⃣ **Start Trigger**\nBegins workflow and receives row_number (the reel number to process).\n\n2️⃣ **Default Value Setup**\nSets row_number_temp = 2 as a fallback if row_number is missing.\n\n3️⃣ **Search Reels Folder**\nLooks in Google Drive for a main folder named “Reels”.\n\n4️⃣ **Check if Reels Folder Exists**\nIF Reels folder is not found → create it.\nELSE → continue with the existing folder.\n\n5️⃣ **Search Current Reel Folder**\nLooks inside the “Reels” folder for a subfolder matching the row_number (e.g., “2”).\n\n6️⃣ **Check if Current Reel Folder Exists**\nIF not found → create a new subfolder for this reel.\nELSE → continue with the existing one.\n\n7️⃣ **Create Current Reel Folder**\nCreates a Google Drive subfolder under “Reels” named after the current row_number.\n\n8️⃣ **No Operation (control step)**\nUsed to merge both possible paths (folder exists / newly created).\n\n9️⃣ **Return Node**\nOutputs structured JSON containing:\n{\n  \"folder_id\": \"Main Reels folder ID\",\n  \"folder_name\": \"Reels\",\n  \"sub_folder_id\": \"Current reel folder ID\",\n  \"sub_folder_name\": \"Current reel folder name\"\n}","height":768,"width":544},"type":"n8n-nodes-base.stickyNote","position":[0,0],"typeVersion":1,"id":"50fbbd8e-4a68-46ac-8f5f-99ff26fe0a5a","name":"Sticky Note"}],"connections":{"Search Reels folder":{"main":[[{"node":"Check if Reels folder does not exist","type":"main","index":0}]]},"Check if Reels folder does not exist":{"main":[[{"node":"create Reels folder","type":"main","index":0}],[{"node":"No Operation, do nothing","type":"main","index":0}]]},"create Reels folder":{"main":[[{"node":"No Operation, do nothing","type":"main","index":0}]]},"Search current making reel folder":{"main":[[{"node":"Check if current reel folder exist","type":"main","index":0}]]},"create current reel folder":{"main":[[{"node":"No Operation, do nothing1","type":"main","index":0}]]},"Check if current reel folder exist":{"main":[[{"node":"create current reel folder","type":"main","index":0}],[{"node":"No Operation, do nothing1","type":"main","index":0}]]},"Start":{"main":[[{"node":"Default value","type":"main","index":0}]]},"No Operation, do nothing":{"main":[[{"node":"Search current making reel folder","type":"main","index":0}]]},"No Operation, do nothing1":{"main":[[{"node":"Return","type":"main","index":0}]]},"Default value":{"main":[[{"node":"Search Reels folder","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{},"versionId":"2483695d-f3d1-46ee-84b8-257938cb0723","triggerCount":0,"shared":[{"updatedAt":"2025-11-09T22:29:00.647Z","createdAt":"2025-11-09T22:29:00.647Z","role":"workflow:owner","workflowId":"vnCCiX3mT3Ca2iKg","projectId":"eC4t1OkxBXcwAfb9"}],"tags":[]}