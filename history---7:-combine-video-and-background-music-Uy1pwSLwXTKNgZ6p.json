{"updatedAt":"2025-12-15T14:26:22.000Z","createdAt":"2025-11-27T05:35:18.230Z","id":"Uy1pwSLwXTKNgZ6p","name":"History - 7: Combine Video And Background Music","active":false,"isArchived":false,"nodes":[{"parameters":{"workflowInputs":{"values":[{"name":"id","type":"any"},{"name":"subFolderId"},{"name":"logoUrl"}]}},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-1824,160],"id":"5aa88ec2-2593-4e80-a3e6-d7557438232d","name":"Start"},{"parameters":{"mode":"raw","jsonOutput":"={\n  \"final_reel_id\": true\n}\n","options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[688,160],"id":"101b4df6-1d83-45e7-9051-0391d6bd90a2","name":"Return"},{"parameters":{"documentId":{"__rl":true,"value":"1mqCt-tHeu1u7fQcXObCvifCRAAzrBlOMDFT7NUypBzI","mode":"list","cachedResultName":"History","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1mqCt-tHeu1u7fQcXObCvifCRAAzrBlOMDFT7NUypBzI/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":523396740,"mode":"list","cachedResultName":"Script","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1mqCt-tHeu1u7fQcXObCvifCRAAzrBlOMDFT7NUypBzI/edit#gid=523396740"},"filtersUI":{"values":[{"lookupColumn":"id","lookupValue":"={{ $json.id }}"},{"lookupColumn":"sentenceType","lookupValue":"hook"}]},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-1440,160],"id":"7be8ec80-7ef1-4027-b5b1-bac077301361","name":"Get row(s) in sheet","credentials":{"googleSheetsOAuth2Api":{"id":"gz6mfhgkzXv8zKAX","name":"Google Sheets account"}}},{"parameters":{"jsCode":"// --- n8n Code Node (UPDATED TO SUM 'audioDuration' FIELD) ---\n// This code runs inside an n8n \"Code\" node.\n// It calculates the hookEndTime as the SUM of the 'audioDuration' field\n// from every segment provided as input.\n\nconst hookStartTime = 0;\nlet hookEndTime = 0; // Initialized to 0 for cumulative summation\n\n// 1. Extract the .json data from all incoming n8n items\nconst videoSegments = items.map(item => item.json);\n\nif (!videoSegments || videoSegments.length === 0) {\n  // If no data, return an error item\n  return [{ json: { error: \"No video segments found.\" } }];\n}\n\n// 2. Loop through every segment and sum the 'audioDuration'\nfor (let i = 0; i < videoSegments.length; i++) {\n  const currentSegment = videoSegments[i];\n  const duration = currentSegment.audioDuration;\n\n  // 3. Ensure the duration field exists and is a valid number\n  if (duration !== undefined && duration !== null) {\n    // We use parseFloat to handle potential string/number mix\n    const segmentDuration = parseFloat(duration);\n\n    if (!isNaN(segmentDuration)) {\n      hookEndTime += segmentDuration; // Cumulative sum of all durations\n    } else {\n      console.warn(`'audioDuration' for segment ${i + 1} is not a valid number (${duration}). Skipping contribution.`);\n    }\n  } else {\n    console.warn(`'audioDuration' is missing for segment ${i + 1}. Skipping contribution.`);\n  }\n}\n\n// 4. Format the final output object\nconst outputData = {\n  hookStartTime,\n  // Rounding to 3 decimal places for clean output\n  hookEndTime: parseFloat(hookEndTime.toFixed(3))\n};\n\n// 5. Return the new object as a single n8n item.\nreturn [{\n  json: outputData\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1232,160],"id":"44f59dd8-bd6f-498b-8d14-918e894747bc","name":"Extract Hook Time"},{"parameters":{"operation":"download","fileId":{"__rl":true,"value":"={{ $('Extract Topic').first().json.musicUrl }}","mode":"url"},"options":{}},"type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[-1008,160],"id":"e8e17f7a-0580-48d1-9363-ab720ec4f388","name":"Download Background Music","credentials":{"googleDriveOAuth2Api":{"id":"TPv6wCUbK61xtBX9","name":"Google Drive account"}}},{"parameters":{"operation":"download","fileId":{"__rl":true,"value":"={{ $('Start').first().json.logoUrl }}","mode":"url"},"options":{}},"type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[-