ption: descriptionArray[language] || '',\n    tiktok_tags: tiktokTagsArray[language] || [],\n    facebook_tags: facebookTagsArray[language] || [],\n    instagram_tags: instaTagsArray[language] || [],\n    youtube_tags: youtubeTagsArray[language] || [],\n    voiceId: voiceIds[index] \n  };\n\n  finalJSON.push(itemJSON);\n});\n\nreturn finalJSON;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2640,352],"id":"75d3d999-fd3f-4ba9-847f-a041a6342ae1","name":"Reconstruct Response JSON"}],"connections":{"Start":{"main":[[{"node":"Get Script Generation Prompt","type":"main","index":0}]]},"write Script":{"main":[[{"node":"Check Sentence Count","type":"main","index":0}]]},"Convert to File":{"main":[[{"node":"Upload file","type":"main","index":0}]]},"Extract Audio":{"main":[[{"node":"Convert to File","type":"main","index":0}]]},"Generate Audio":{"main":[[{"node":"Extract Audio","type":"main","index":0}]]},"Upload file":{"main":[[{"node":"Loop Over Items","type":"main","index":0}]]},"Get Script Generation Prompt":{"main":[[{"node":"write Script","type":"main","index":0}]]},"Loop Over Items":{"main":[[{"node":"Make Single Response","type":"main","index":0}],[{"node":"Add Tags","type":"main","index":0}]]},"Make Single Response":{"main":[[{"node":"Return","type":"main","index":0}]]},"If":{"main":[[{"node":"Make Sentences With Seperator For Sheet","type":"main","index":0}],[{"node":"Send Error Mail","type":"main","index":0}]]},"Check Sentence Count":{"main":[[{"node":"If","type":"main","index":0}]]},"Add Tags":{"main":[[{"node":"Remove Double Quotes From Script","type":"main","index":0}]]},"Remove Double Quotes From Script":{"main":[[{"node":"Generate Audio","type":"main","index":0}]]},"Append or update row in sheet":{"main":[[{"node":"Make VoiceIds Array","type":"main","index":0}]]},"Make VoiceIds Array":{"main":[[{"node":"Reconstruct Response JSON","type":"main","index":0}]]},"Make Sentences With Seperator For Sheet":{"main":[[{"node":"Append or update row in sheet","