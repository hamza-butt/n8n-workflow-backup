rl":true,"value":"gid=0","mode":"list","cachedResultName":"Main","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1mqCt-tHeu1u7fQcXObCvifCRAAzrBlOMDFT7NUypBzI/edit#gid=0"},"filtersUI":{"values":[{"lookupColumn":"id","lookupValue":"={{ $('Start').item.json.id }}"}]},"options":{"returnFirstMatch":true}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[2176,336],"id":"b29fb50e-966f-4c90-8a4f-c953911e40bc","name":"Extract topic","credentials":{"googleSheetsOAuth2Api":{"id":"WSNa9GY4baOGGbLB","name":"Google Sheets account"}}},{"parameters":{"content":"## Generate images scenes and thumbnail prompt and save thumbnail to google drive","height":528,"width":864,"color":4},"type":"n8n-nodes-base.stickyNote","position":[2768,48],"typeVersion":1,"id":"c58bd1af-8069-4c8b-82c5-debaa1d5ad00","name":"Sticky Note2"},{"parameters":{"content":"## Generate images for all scenes and upload to google drive","height":528,"width":1280,"color":5},"type":"n8n-nodes-base.stickyNote","position":[3696,48],"typeVersion":1,"id":"df5f9f4f-8c95-4bb5-8827-9d79e95ab718","name":"Sticky Note3"},{"parameters":{"jsCode":"// The separator used when saving\nconst SEP = '\\u001F';\n\nreturn items.map(({ json }) => {\n  // Parse the string from the Google Sheet\n  const data = typeof json.sentences === 'string' ? JSON.parse(json.sentences) : json.sentences;\n\n  // Get English string directly\n  const enJoined = data.en; // e.g. \"Sentence1␟Sentence2␟Sentence3\"\n\n  return { json: { en_text: enJoined } };\n});\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2368,336],"id":"a077fd2d-de51-48c5-924b-b191f44de8b3","name":"Extract Sentences Array"},{"parameters":{"jsCode":"/*\n=================================================================\n  n8n Code Node: Sentence Counter\n=================================================================\n  MODE: Run Once for First Item\n  LANGUAGE: JavaScript\n\n  This node reads the 'en_text' field from the first input item,\n  splits it based on the '\\u001f' delimiter, and returns\n  the total count of sentences.\n=================================================================\n*/\n\ntry {\n  // 1. Get the 'en_text' field from the first item's JSON data.\n  // This uses the $input variable available in \"Run Once for First Item\" mode.\n  const en_text = $input.first().json.en_text;\n\n  let sentenceCount = 0;\n  let sentencesArray = [];\n\n  // 2. Check if 'en_text' is a valid, non-empty string\n  if (typeof en_text === 'string' && en_text.trim() !== '') {\n    \n    // 3. Split the string by the special delimiter\n    sentencesArray = en_text.split('\\u001f');\n    \n    // 4. The length of the resulting array is our sentence count\n    sentenceCount = sentencesArray.length;\n  }\n\n  // 5. Return the output JSON.\n  // This will be the output of the node.\n  return {\n    sentenceCount: sentenceCount,\n    // You can uncomment the line below if you also want to see\n    // the split sentences in the output.\n    // sentences: sentencesArray\n  };\n\n} catch (error) {\n  // 6. Handle any errors (like 'en_text' not existing)\n  console.error(\"Error processing item:\", error.message);\n  \n  // Return an item with an error message\n  return {\n    error: `Failed to process item: ${error.message}`\n  };\n}\n\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2576,336],"id":"887bf730-f59d-42ec-a74d-190ffa20abf1","name":"Count Sentences"},{"parameters":{"description":"This thinking tool must plan → verify → write → self-check before output.\n\n1) Parse and Count\nSplit sentences by \\u001F and confirm that scenes.length equals numberOfSentences.\nKeep each original sentence verbatim as voiceOverText.\n\n2) Plan Unified Visual Style\nUse historical realism with a subtle fantasy aura: ethereal volumetric light, faint embers, light haze, slightly heightened colors.\nEnsure one clear main subject, an uncluttered background, a strong silhouette, and a 9:16 vertical frame with a Rembrandt or chiaroscuro mood.\nPalette should be deep blue or teal shadows with warm amber or orange highlights.\nUse a 35mm lens for establishing or action and a 50mm lens for portraits or close shots, with slight background blur and soft film grain.\n\n3) Write Each Scene Prompt Using the Pattern\nInclude subject and action; era, location, and architecture; accurate clothing and props; composition choice (close, medium, or wide with framing and leading lines); lens; lighting; atmosphere; palette; and quality flags.\nExplicitly include the phrase NO TEXT VISIBLE inside every prompt.\nAppend the NEGATIVE block at the end of every prompt.\n\n4) Enforce Historical Accuracy\nPrefer verified or public-domain cues.\nIf uncertain, choose era-appropriate generic imagery instead of introducing anachronisms.\n\n5) Choose Thumbnail\nPick the most emotional or symbolic scene, preferably featuring a face or hands, and add stronger rim light, high contrast, and a mystery prop.\nInclude NO TEXT VISIBLE and the NEGATIVE block.\n\n6) Validate JSON and Rules\nEnsure scene count matches numberOfSentences.\nConfirm every prompt contains the required style elements, the NO TEXT VISIBLE callout, and the NEGATIVE block.\nReturn only the specified JSON shape."},"type":"@n8n/n8n-nodes-langchain.toolThink","typeVersion":1.1,"position":[2912,544],"id":"346a73a0-a9b1-418b-81bc-191322dd7f84","name":"Think"}],"connections":{"write image prompt":{"main":[[{"node":"Generate thumbnail","type":"main","index":0}]]},"Start":{"main":[[{"node":"Get Image Generation Prompt","type":"main","index":0}]]},"Get Image Generation Prompt":{"main":[[{"node":"Extract topic","type":"main","index":0}]]},"Loop Over Items":{"main":[[{"node":"Make Single Response","type":"main","index":0}],[{"node":"Generate image","type":"main","index":0}]]},"Generate image":{"main":[[{"node":"download image","type":"main","index":0}]]},"download image":{"main":[[{"node":"update image to folder","type":"main","index":0}]]},"update image to folder":{"main":[[{"node":"Loop Over Items","type":"main","index":0}]]},"Extract only scenes array":{"main":[[{"node":"Split Out","type":"main","index":0}]]},"Split Out":{"main":[[{"node":"Loop Over Items","type":"main","index":0}]]},"Generate thumbnail":{"main":[[{"node":"download thumbnail","type":"main","index":0}]]},"download thumbnail":{"main":[[{"node":"upload thumbnail to drive","type":"main","index":0}]]},"upload thumbnail to drive":{"main":[[{"node":"Extract only scenes array","type":"main","index":0}]]},"Make Single Response":{"main":[[{"node":"Return","type":"main","index":0}]]},"Extract topic":{"main":[[{"node":"Extract Sentences Array","type":"main","index":0}]]},"Extract Sentences Array":{"main":[[{"node":"Count Sentences","type":"main","index":0}]]},"Count Sentences":{"main":[[{"node":"write image prompt","type":"main","index":0}]]},"Think":{"ai_tool":[[{"node":"write image prompt","type":"ai_tool","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{"Start":[{"json":{"subFolderId":"1DcL93FW-q8Sz6x8vXp2vQvpjJSGqvWeH","promptUrl":"https://docs.google.com/document/d/1AAyRGbkgvWnZAR_rtQ4V1Zfjbvwd_LmRC6IW86_XXK8/edit?tab=t.0","id":1}}]},"versionId":"c7b6120e-ecfc-4ae5-873d-574735560d8a","triggerCount":0,"shared":[{"createdAt":"2025-10-22T11:36:54.648Z","updatedAt":"2025-10-22T11:36:54.648Z","role":"workflow:owner","workflowId":"VJ1SH6Dm2DXvW6Cl","projectId":"9a0xiXJorpvjZQvj"}],"tags":[]}