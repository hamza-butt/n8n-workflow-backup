ly created).\n\n9️⃣ **Return Node**\nOutputs structured JSON containing:\n{\n  \"folder_id\": \"Main Reels folder ID\",\n  \"folder_name\": \"Reels\",\n  \"sub_folder_id\": \"Current reel folder ID\",\n  \"sub_folder_name\": \"Current reel folder name\"\n}","height":768,"width":544},"type":"n8n-nodes-base.stickyNote","position":[0,0],"typeVersion":1,"id":"beebf8cb-2a80-4a98-979d-a287f5028e5a","name":"Sticky Note"}],"connections":{"Search Reels folder":{"main":[[{"node":"Check if Reels folder does not exist","type":"main","index":0}]]},"Check if Reels folder does not exist":{"main":[[{"node":"create Reels folder","type":"main","index":0}],[{"node":"No Operation, do nothing","type":"main","index":0}]]},"create Reels folder":{"main":[[{"node":"No Operation, do nothing","type":"main","index":0}]]},"Search current making reel folder":{"main":[[{"node":"Check if current reel folder exist","type":"main","index":0}]]},"create current reel folder":{"main":[[{"node":"No Operation, do nothing1","type":"main","index":0}]]},"Check if current reel folder exist":{"main":[[{"node":"create current reel folder","type":"main","index":0}],[{"node":"No Operation, do nothing1","type":"main","index":0}]]},"Start":{"main":[[{"node":"Default value","type":"main","index":0}]]},"No Operation, do nothing":{"main":[[{"node":"Search current making reel folder","type":"main","index":0}]]},"No Operation, do nothing1":{"main":[[{"node":"Return","type":"main","index":0}]]},"Default value":{"main":[[{"node":"Search Reels folder","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{},"versionId":"6d881a49-e05d-4b79-957a-ec5e227e0129","triggerCount":0,"shared":[{"createdAt":"2025-10-18T12:03:11.587Z","updatedAt":"2025-10-18T12:03:11.587Z","role":"workflow:owner","workflowId":"ouRAnMPY5jnm6IVF","projectId":"9a0xiXJorpvjZQvj"}],"tags":[]}