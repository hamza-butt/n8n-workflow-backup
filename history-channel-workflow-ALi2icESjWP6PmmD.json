8n-nodes-base.stickyNote","position":[-3008,496],"typeVersion":1,"id":"004d41af-8fd0-430a-8a43-c52731e84c68","name":"Sticky Note2"},{"parameters":{"jsCode":"/**\n * This script takes a comma-separated string of languages\n * from a previous node and converts it into an array of strings.\n * It also trims any whitespace from each language code.\n */\n\n// 1. Get the language string from the 'Extract topic' node\n// Note: Using $input.first().json is often more robust in n8n\n// but $('Extract topic') works if the node is named that.\nconst languagesString = $('Extract topic').first().json.languages;\n\nlet languagesArray = [];\n\n// 2. Check if languagesString is a valid string\nif (typeof languagesString === 'string' && languagesString.length > 0) {\n  \n  // 3. Split the string by the comma\n  //    and then map over the array to trim whitespace\n  //    from each item (e.g., \" de\" becomes \"de\")\n  languagesArray = languagesString.split(',')\n                                  .map(lang => lang.trim());\n} else {\n  console.log(\"Languages string is empty or not found.\");\n}\n\n// 4. Return the new array\n// This makes it available to subsequent nodes\nreturn {\n  languages: languagesArray\n};\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-2448,656],"id":"d4598cff-e6df-423d-8c28-57ac1930d6ea","name":"Convert Languages String To Array"},{"parameters":{"content":"## 4\n* **`subFolderId`** – used in Google Drive to locate audio/image files and upload final video.\n* **`language`** – used to select audio file and name the output video.\n* **`id`** – used in Google Sheets to extract sentence data.\n\n","height":544,"width":960,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-2528,320],"typeVersion":1,"id":"008914da-f71b-48a2-ac60-230ff60e980f","name":"Sticky Note3"},{"parameters":{"content":"## 5\n* **`id`** – used in Google Sheets to fetch topic sentences and update selected music.\n* **`promptUrl`** – used in Google Docs to fetch GPT promp